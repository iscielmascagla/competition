@await Html.PartialAsync("_VideoModal")
@{
    string imagePath = "background-image: url(" + ViewBag.CurrentQuestion.BackgroundImage + ");";
}
<!doctype html>
<html lang="en" class="remember-theme">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1.0">
    <title>Quiz</title>
    <meta name="description" content="OneUI - Bootstrap 5 Admin Template &amp; UI Framework created by pixelcave">
    <meta name="author" content="pixelcave">
    <meta name="robots" content="index, follow">
    <link rel="stylesheet" id="css-main" href="~/css/oneui.min.css">
    <link href="~/css/custom.css" rel="stylesheet" />
 
</head>
<body>
    <canvas id="confetti-canvas" style="position: fixed; top: 0; left: 0; width: 100%; height: 100%; pointer-events: none; z-index: 9999;"></canvas>
    <div id="page-container">
        <main id="main-container">
            <div class="bg-image" style="@imagePath">
                <div class="container-alt-alta">
                    <div class="quiz-container ">
                        <div id="timer-container" >
                            <span id="timer">20</span>
                        </div>
                        <h4 class="h3 fw-bold text-white mb-2">
                            @ViewBag.CurrentQuestion.QuestionText
                        </h4>
                    </div>
                    <div class="quiz-container">
                        <div class="options-container">
                            <form method="post" action="/Quiz/AnswerQuestion" class="question-form">
                                <div class="options-row">
                                    <div class="form-check">
                                        <button type="button" class="option-btn fw-bold" id="option0" data-index="0">
                                            @ViewBag.CurrentQuestion.Options[0]
                                        </button>
                                    </div>
                                    <div class="form-check">
                                        <button type="button" class="option-btn fw-bold" id="option1" data-index="1">
                                            @ViewBag.CurrentQuestion.Options[1]
                                        </button>
                                    </div>
                                </div>
                                <div class="options-row">
                                    <div class="form-check">
                                        <button type="button" class="option-btn fw-bold " id="option2" data-index="2">
                                            @ViewBag.CurrentQuestion.Options[2]
                                        </button>
                                    </div>
                                    <div class="form-check">
                                        <button type="button" class="option-btn fw-bold" id="option3" data-index="3">
                                            @ViewBag.CurrentQuestion.Options[3]
                                        </button>
                                    </div>
                                </div>
                                <input type="hidden" id="selectedOption" name="selectedOption" value="-1" />
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <script src="~/js/oneui.app.min.js"></script>
    <script src="~/js/jquery.min.js"></script>

    <script>
        let timeLeft = 20;   // Geri sayım süresi
        let timerElement = document.getElementById("timer");
        let timerInterval;
        let isAnswered = false; // Kullanıcının yanıt verip vermediğini kontrol eder
        let hasSelectedOption = false; // Kullanıcının bir seçenek seçip seçmediğini kontrol eder
        let isTimeOut = false; // Sürenin bitip bitmediğini kontrol eder

        $(document).ready(function () {
            $(".option-btn").click(function () {
                if (isAnswered) return; // Eğer zaten cevap verildiyse tekrar çalıştırma

                hasSelectedOption = true; // Bir seçenek seçildi
                window.selectedOption = $(this).data("index");  // Seçenek bilgisini global değişkende sakla
                console.log("Seçilen Seçenek İndeksi:", window.selectedOption);
                $("#selectedOption").val(window.selectedOption);

                var correctAnswerIndex = @ViewBag.CurrentQuestion.CorrectAnswerIndex;

               
                $(".option-btn").prop("disabled", true);

                if (window.selectedOption === correctAnswerIndex) {
                    $(this).addClass("correct"); // Yeşil arka plan
                } else {
                    $(this).addClass("incorrect"); // Kırmızı arka plan
                }

                // Kullanıcı cevap verdi, timer'ı durdur
                clearInterval(timerInterval);
            });

            $("#videoModal").on("hidden.bs.modal", function () {
                console.log("Video kapandı");
                $("form.question-form").submit();
            });
        });

        // Klavye olayını ekleyelim
        $(document).keydown(function (event) {
            // Enter tuşuna basıldığında ve bir cevap seçilmişse video modalını aç
            if (event.key === "Enter" && hasSelectedOption && !isAnswered) {
                isAnswered = true; // Cevap verildi olarak işaretle
                openVideoModal();
            }
            // Süre bittikten sonra Enter'a basılırsa ve cevap verilmediyse yanlış cevap videosunu aç
            else if (event.key === "Enter" && isTimeOut && !isAnswered) {
                isAnswered = true;
                window.selectedOption = -1; // Cevap verilmediğini belirtmek için -1 atayabiliriz
                openVideoModal();
            }
            else if (!timerInterval && event.key === "Enter" && !hasSelectedOption) {
                startTimer(); // İlk Enter'da timer'ı başlat
            } else if (!isAnswered) { // Cevap verilmediyse klavye ile seçim yap
                let selectedOption = -1;
                switch (event.key) {
                    case "a": case "A":
                        selectedOption = 0;
                        break;
                    case "b": case "B":
                        selectedOption = 1;
                        break;
                    case "c": case "C":
                        selectedOption = 2;
                        break;
                    case "d": case "D":
                        selectedOption = 3;
                        break;
                    default:
                        return; // Geçersiz tuşa basıldığında hiçbir şey yapma
                }

                if (selectedOption !== -1) {
                    $("#option" + selectedOption).click();  // İlgili seçeneği tıkla
                }
            }
        });

        function updateTimer() {
            if (timeLeft > 0) {
                timeLeft--;
                timerElement.textContent = timeLeft;
            } else {
                clearInterval(timerInterval);
                if (!isAnswered) {
                    console.log("Süre bitti!");
                    isTimeOut = true; // Sürenin bittiğini işaretle
                    // Kullanıcının Enter'a basmasını bekle
                }
            }
        }

        function openVideoModal() {
            if (window.timerInterval) {
                clearInterval(window.timerInterval);
            }
            let videoModal = new bootstrap.Modal(document.getElementById("videoModal"));
            let videoPlayer = document.getElementById("videoPlayer");
            let videoSource = document.getElementById("videoSource");

            // Seçilen cevabın doğru olup olmadığını kontrol et
            let isCorrect = window.selectedOption == @ViewBag.CurrentQuestion.CorrectAnswerIndex;

            let videoUrl = isCorrect ? "@ViewBag.CurrentQuestion.CorrectAnswerVideoRed" : "@ViewBag.CurrentQuestion.UncorrectAnswerVideoRed";

            // Eğer süre bittiyse ve cevap verilmediyse yanlış cevap videosunu zorla göster
            if (isTimeOut && !hasSelectedOption) {
                videoUrl = "@ViewBag.CurrentQuestion.UncorrectAnswerVideoRed";
            }

            if (videoUrl) {
                videoSource.src = videoUrl;
                videoPlayer.load();
                videoModal.show();
                videoPlayer.play();
            }

            videoPlayer.onended = function() {
                $("form.question-form").submit();
            };
        }

        function startTimer() {
            console.log("Timer Başlatılıyor...");
            timeLeft = 20;   // Timer'ı sıfırla
            timerElement.textContent = timeLeft;
            timerInterval = setInterval(updateTimer, 1000); // Timer'ı başlat
        }
    </script>
    
</body>
</html>
