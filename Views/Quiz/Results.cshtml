
<!doctype html>
<html lang="en" class="remember-theme">
<head>
    <meta charset="utf-8">
    
    <meta name="viewport" content="width=device-width,initial-scale=1.0">

    <title>Results</title>

    <meta name="description" content="OneUI - Bootstrap 5 Admin Template &amp; UI Framework created by pixelcave">
    <meta name="author" content="pixelcave">
    <meta name="robots" content="index, follow">

    <!-- Open Graph Meta -->
    <meta property="og:title" content="OneUI - Bootstrap 5 Admin Template &amp; UI Framework">
    <meta property="og:site_name" content="OneUI">
    <meta property="og:description" content="OneUI - Bootstrap 5 Admin Template &amp; UI Framework created by pixelcave">
    <meta property="og:type" content="website">
    <meta property="og:url" content="">
    <meta property="og:image" content="">

    
    <!-- Stylesheets -->
    <!-- OneUI framework -->
    <link rel="stylesheet" id="css-main" href="~/css/oneui.min.css">
   


</head>

<body>

    <div id="page-container" >
        <!-- Main Container -->
        <main id="main-container">
            <!-- Page Content -->
            <div class="bg-image" style="background-image: url('/media/image/results.jpg');">
                
                <div class="content">
                    
                    <!-- Takım Bilgileri ve Skorlar -->
                    <div class="scoreboard">
                        <div class="team-card">   
                            
                            <h3 class="team-score">@ViewBag.Team1Score</h3>
                        </div>
                        <div class="team-card">  
                           
                            <h3 class="team-score">@ViewBag.Team2Score</h3>
                        </div>
                    </div>
                    
                   

                </div>
            </div>
            <!-- END Page Content -->
        </main>
        </div>
        <!-- END Main Container -->
    
    <!-- END Page Container -->
    <!--
        OneUI JS

        Core libraries and functionality
        webpack is putting everything together at assets/_js/main/app.js
    -->

    
	<script src="~/js/oneui.app.min.js"></script>
    <!-- jQuery (required for jQuery Validation plugin) -->

    <script src="~/js/jquery.min.js"></script>
    <script>
        document.addEventListener('keydown', function (event) {
            if (event.key === 'Enter') {
                window.location.href = '/Quiz/ShowWinner'; // Burada, geçmek istediğiniz sayfanın URL'sini verin
            }
        });
    </script>
    
</body>
</html>




<!-- CSS -->
<style>
   
    .bg-image {
        background-size: cover;
        background-repeat: no-repeat;
        background-position: center;
        background-size: 100%;
        padding: 50px 0;
        min-height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .content {
        background-color: transparent; /* Hafif şeffaf arka plan */
        padding: 0px;
        border-radius: 15px;
       
        text-align: center;
        max-width: 100px; /* Maksimum genişlik */
        width: 100%;
        box-sizing: border-box;
    }

    .scoreboard {
        background-color: transparent;
        display: flex;
        justify-content: center;
        gap: 385px; /* İki öğe arasındaki mesafeyi azalt */
        margin-bottom: 0px;
        margin-top: 50px;
        width: 100%;
    }

    .team-card {
        background-color: transparent;
        color: white;
        border-radius: 0px;
        width: 20%; /* Daha dar hale getir */
    }

    

    .team-score {
        font-size: 3.2rem;
        color: white;
       
    }

    .team-name {
        font-size: 1.5rem;
        color: white;
        font-weight: bold;
        padding: 0px;
        margin-bottom:0px;
       

    }

    .game-result {
        margin-top: 20px;
    }

    .result-text {
        font-size: 2rem;
        font-weight: bold;
        color: #333;
    }
</style>
