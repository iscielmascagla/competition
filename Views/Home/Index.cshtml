<body>


    <div id="page-container" class="page-header-dark main-content-boxed">


        <main id="main-container">

            <div class="bg-image" style="background-image: url('/media/image/start1.jpg');">
            </div>
            <!-- END Page Content -->
            <!-- END Page Content -->
        </main>
        <!-- END Main Container -->

